CHECKWX_API_KEY=
# Server-only: automatic POH chart extraction (never use a VITE_ prefix).
OPENAI_API_KEY=
POH_OPENAI_MODEL=gpt-4.1
# Optional comma-separated Firebase user IDs allowed to use paid POH processing.
POH_ALLOWED_UIDS=
AVIATION_WEATHER_PROVIDER=aviationweather
# Optional: enables automatic route-aerodrome NOTAM retrieval in Briefing.
SKYLINK_API_KEY=
# Optional server fallback. The Calendar UI normally asks each signed-in user for their own token.
FLIGHTLOGGER_API_TOKEN=
FLIGHTLOGGER_API_URL=https://api.flightlogger.net/graphql
